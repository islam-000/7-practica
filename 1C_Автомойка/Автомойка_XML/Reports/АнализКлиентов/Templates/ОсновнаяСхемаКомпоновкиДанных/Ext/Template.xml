		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Заказ.Клиент КАК Клиент,
	Заказ.Клиент.Телефон КАК Телефон,
	КОЛИЧЕСТВО(Заказ.Ссылка) КАК КоличествоЗаказов,
	СУММА(Заказ.Сумма) КАК Сумма,
	СУММА(Заказ.Сумма) / КОЛИЧЕСТВО(Заказ.Ссылка) КАК СреднийЧек,
	МАКСИМУМ(Заказ.Дата) КАК ПоследнийВизит
ИЗ
	Документ.ЗаказНаМойку КАК Заказ
ГДЕ
	Заказ.Проведен
	И Заказ.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода

СГРУППИРОВАТЬ ПО
	Заказ.Клиент,
	Заказ.Клиент.Телефон</query>
