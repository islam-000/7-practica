		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Строки.Ссылка.Бокс КАК Бокс,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Строки.Ссылка) КАК Заказов,
	СУММА(Строки.Количество * Строки.Услуга.ВремяВыполнения) КАК Минут,
	ВЫРАЗИТЬ(СУММА(Строки.Количество * Строки.Услуга.ВремяВыполнения) / 60 КАК ЧИСЛО(10, 1)) КАК Часов,
	СУММА(Строки.Сумма) КАК Сумма
ИЗ
	Документ.ЗаказНаМойку.Услуги КАК Строки
ГДЕ
	Строки.Ссылка.Проведен
	И Строки.Ссылка.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода

СГРУППИРОВАТЬ ПО
	Строки.Ссылка.Бокс</query>
