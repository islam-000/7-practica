// Документ "Заказ на мойку".
// - при записи подставляет цены услуг (регистр ЦеныУслуг, иначе цена из справочника) и считает суммы;
// - при проведении списывает материалы, которые расходуются на услуги (регистр ОстаткиМатериалов).

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Статус = Перечисления.СтатусЗаказа.Новый;

	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.Автомобили") Тогда
		Автомобиль = ДанныеЗаполнения;
		Клиент     = ДанныеЗаполнения.Владелец;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не ЗначениеЗаполнено(Клиент) Тогда
		Сообщить("Укажите клиента.");
		Отказ = Истина;
	КонецЕсли;

	Если Услуги.Количество() = 0 Тогда
		Сообщить("Добавьте хотя бы одну услугу.");
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если Не ЗначениеЗаполнено(Статус) Тогда
		Статус = Перечисления.СтатусЗаказа.Новый;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Клиент) И ЗначениеЗаполнено(Автомобиль) Тогда
		Клиент = Автомобиль.Владелец;
	КонецЕсли;

	Для Каждого Строка Из Услуги Цикл
		Если Строка.Количество = 0 Тогда
			Строка.Количество = 1;
		КонецЕсли;
		Если Строка.Цена = 0 И ЗначениеЗаполнено(Строка.Услуга) Тогда
			Строка.Цена = ЦенаУслуги(Строка.Услуга);
		КонецЕсли;
		Строка.Сумма = Строка.Количество * Строка.Цена;
	КонецЦикла;

	Сумма = Услуги.Итог("Сумма");

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	Движения.ОстаткиМатериалов.Записывать = Истина;

	Для Каждого Строка Из Услуги Цикл
		Если Не ЗначениеЗаполнено(Строка.Услуга) Тогда
			Продолжить;
		КонецЕсли;
		Материал = Строка.Услуга.ИспользуемыйМатериал;
		Расход   = Строка.Услуга.РасходМатериала * Строка.Количество;
		Если ЗначениеЗаполнено(Материал) И Расход > 0 Тогда
			Движение = Движения.ОстаткиМатериалов.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период      = Дата;
			Движение.Материал    = Материал;
			Движение.Количество  = Расход;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ЦенаУслуги(Услуга)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цены.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныУслуг.СрезПоследних(&НаДату, Услуга = &Услуга) КАК Цены";
	Запрос.УстановитьПараметр("Услуга", Услуга);
	Запрос.УстановитьПараметр("НаДату", ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса()));

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Цена;
	КонецЕсли;

	Возврат Услуга.Цена;

КонецФункции

#КонецЕсли
