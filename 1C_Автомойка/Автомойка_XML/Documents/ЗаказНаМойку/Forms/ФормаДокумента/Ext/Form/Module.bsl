// Форма документа "Заказ на мойку": мгновенный пересчёт сумм.

&НаКлиенте
Процедура АвтомобильПриИзменении(Элемент)

	Если ЗначениеЗаполнено(Объект.Автомобиль) Тогда
		Объект.Клиент = ВладелецАвтомобиля(Объект.Автомобиль);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УслугиУслугаПриИзменении(Элемент)

	Строка = Элементы.Услуги.ТекущиеДанные;
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Строка.Количество = 0 Тогда
		Строка.Количество = 1;
	КонецЕсли;
	Строка.Цена = ЦенаУслуги(Строка.Услуга, Объект.Дата);
	ПересчитатьСтроку(Строка);

КонецПроцедуры

&НаКлиенте
Процедура УслугиКоличествоПриИзменении(Элемент)

	Строка = Элементы.Услуги.ТекущиеДанные;
	Если Строка <> Неопределено Тогда
		ПересчитатьСтроку(Строка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УслугиПослеУдаления(Элемент)

	Объект.Сумма = Объект.Услуги.Итог("Сумма");

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтроку(Строка)

	Строка.Сумма = Строка.Количество * Строка.Цена;
	Объект.Сумма = Объект.Услуги.Итог("Сумма");

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЦенаУслуги(Услуга, Дата)

	Если Не ЗначениеЗаполнено(Услуга) Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Цены.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныУслуг.СрезПоследних(&НаДату, Услуга = &Услуга) КАК Цены";
	Запрос.УстановитьПараметр("Услуга", Услуга);
	Запрос.УстановитьПараметр("НаДату", ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса()));

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Цена;
	КонецЕсли;

	Возврат Услуга.Цена;

КонецФункции

&НаСервереБезКонтекста
Функция ВладелецАвтомобиля(Автомобиль)

	Возврат Автомобиль.Владелец;

КонецФункции
