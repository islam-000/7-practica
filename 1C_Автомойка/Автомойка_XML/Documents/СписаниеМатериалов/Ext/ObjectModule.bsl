// Документ "Списание материалов": расход материалов с контролем остатков.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ОбработкаПроведения(Отказ, Режим)

	// Блокируем остатки списываемых материалов на время проведения.
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОстаткиМатериалов");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = Материалы;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Материал", "Материал");
	Блокировка.Заблокировать();

	Движения.ОстаткиМатериалов.Записывать = Истина;

	Для Каждого Строка Из Материалы Цикл
		Движение = Движения.ОстаткиМатериалов.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период      = Дата;
		Движение.Материал    = Строка.Материал;
		Движение.Количество  = Строка.Количество;
	КонецЦикла;

	Движения.Записать();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Материал КАК Материал,
	|	Остатки.КоличествоОстаток КАК Остаток
	|ИЗ
	|	РегистрНакопления.ОстаткиМатериалов.Остатки(
	|			,
	|			Материал В
	|				(ВЫБРАТЬ
	|					Т.Материал
	|				ИЗ
	|					Документ.СписаниеМатериалов.Материалы КАК Т
	|				ГДЕ
	|					Т.Ссылка = &Ссылка)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток < 0";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Сообщить("Недостаточно материала """ + Выборка.Материал + """, не хватает: " + (-Выборка.Остаток));
		Отказ = Истина;
	КонецЦикла;

КонецПроцедуры

#КонецЕсли
