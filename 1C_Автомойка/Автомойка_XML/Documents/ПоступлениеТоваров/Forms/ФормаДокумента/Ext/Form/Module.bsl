// Форма документа "Поступление товаров": мгновенный пересчёт сумм.

&НаКлиенте
Процедура МатериалыМатериалПриИзменении(Элемент)

	Строка = Элементы.Материалы.ТекущиеДанные;
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Строка.Цена = ЦенаМатериала(Строка.Материал);
	ПересчитатьСтроку(Строка);

КонецПроцедуры

&НаКлиенте
Процедура МатериалыКоличествоПриИзменении(Элемент)

	Строка = Элементы.Материалы.ТекущиеДанные;
	Если Строка <> Неопределено Тогда
		ПересчитатьСтроку(Строка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура МатериалыПослеУдаления(Элемент)

	Объект.Сумма = Объект.Материалы.Итог("Сумма");

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтроку(Строка)

	Строка.Сумма = Строка.Количество * Строка.Цена;
	Объект.Сумма = Объект.Материалы.Итог("Сумма");

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЦенаМатериала(Материал)

	Если Не ЗначениеЗаполнено(Материал) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Материал.Цена;

КонецФункции
