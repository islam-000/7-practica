// Документ "Поступление товаров": приход материалов на склад.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Для Каждого Строка Из Материалы Цикл
		Если Строка.Цена = 0 И ЗначениеЗаполнено(Строка.Материал) Тогда
			Строка.Цена = Строка.Материал.Цена;
		КонецЕсли;
		Строка.Сумма = Строка.Количество * Строка.Цена;
	КонецЦикла;

	Сумма = Материалы.Итог("Сумма");

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	Движения.ОстаткиМатериалов.Записывать = Истина;

	Для Каждого Строка Из Материалы Цикл
		Движение = Движения.ОстаткиМатериалов.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период      = Дата;
		Движение.Материал    = Строка.Материал;
		Движение.Количество  = Строка.Количество;
		Движение.Сумма       = Строка.Сумма;
	КонецЦикла;

КонецПроцедуры

#КонецЕсли
