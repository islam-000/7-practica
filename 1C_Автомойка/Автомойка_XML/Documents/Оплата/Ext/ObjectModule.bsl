// Документ "Оплата": вводится на основании заказа, при проведении пишет выручку.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказНаМойку") Тогда
		Заказ     = ДанныеЗаполнения;
		Клиент    = ДанныеЗаполнения.Клиент;
		ВидОплаты = ДанныеЗаполнения.ВидОплаты;
		Сумма     = ДанныеЗаполнения.Сумма;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Сумма <= 0 Тогда
		Сообщить("Сумма оплаты должна быть больше нуля.");
		Отказ = Истина;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ВидОплаты) Тогда
		Сообщить("Укажите вид оплаты.");
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	Движения.Выручка.Записывать = Истина;

	Движение = Движения.Выручка.Добавить();
	Движение.Период    = Дата;
	Движение.Клиент    = Клиент;
	Движение.ВидОплаты = ВидОплаты;
	Движение.Сумма     = Сумма;

	// Оплаченный заказ переводим в статус "Выдан".
	Если ЗначениеЗаполнено(Заказ) Тогда
		ЗаказОбъект = Заказ.ПолучитьОбъект();
		Если ЗаказОбъект.Статус <> Перечисления.СтатусЗаказа.Выдан Тогда
			ЗаказОбъект.Статус = Перечисления.СтатусЗаказа.Выдан;
			ЗаказОбъект.Записать(?(ЗаказОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецЕсли
