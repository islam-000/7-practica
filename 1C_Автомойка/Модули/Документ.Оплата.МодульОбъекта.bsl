// Документ "Оплата" — модуль объекта.
// Движения: РегистрНакопления.Выручка (Клиент, ВидОплаты / Сумма).
// В свойствах документа: Проведение = Разрешить, Движения -> отметить регистр "Выручка".

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	// Ввод на основании документа "Заказ на мойку".
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказНаМойку") Тогда
		Заказ      = ДанныеЗаполнения;
		Клиент     = ДанныеЗаполнения.Клиент;
		ВидОплаты  = ДанныеЗаполнения.ВидОплаты;
		Сумма      = ДанныеЗаполнения.Сумма;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Сумма <= 0 Тогда
		Сообщить("Сумма оплаты должна быть больше нуля.");
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	Движения.Выручка.Записывать = Истина;

	Движение = Движения.Выручка.Добавить();
	Движение.Период    = Дата;
	Движение.Клиент    = Клиент;
	Движение.ВидОплаты = ВидОплаты;
	Движение.Сумма     = Сумма;

КонецПроцедуры
