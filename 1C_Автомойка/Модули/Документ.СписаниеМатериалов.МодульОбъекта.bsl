// Документ "Списание материалов" — модуль объекта.
// Движения: РегистрНакопления.ОстаткиМатериалов (Расход) с контролем остатков.

Процедура ОбработкаПроведения(Отказ, Режим)

	Движения.ОстаткиМатериалов.Записывать = Истина;

	Для Каждого Строка Из Материалы Цикл
		Движение = Движения.ОстаткиМатериалов.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период      = Дата;
		Движение.Материал    = Строка.Материал;
		Движение.Количество  = Строка.Количество;
	КонецЦикла;

	// Записываем движения и проверяем, не ушёл ли остаток в минус.
	Движения.Записать();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Материал КАК Материал,
	|	Остатки.КоличествоОстаток КАК Остаток
	|ИЗ
	|	РегистрНакопления.ОстаткиМатериалов.Остатки(
	|			,
	|			Материал В
	|				(ВЫБРАТЬ
	|					Т.Материал
	|				ИЗ
	|					Документ.СписаниеМатериалов.Материалы КАК Т
	|				ГДЕ
	|					Т.Ссылка = &Ссылка)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток < 0";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Сообщить("Недостаточно материала """ + Выборка.Материал + """, не хватает: "
			+ (-Выборка.Остаток));
		Отказ = Истина;
	КонецЦикла;

КонецПроцедуры
