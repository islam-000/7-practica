// Документ "Заказ на мойку" — модуль формы документа.
// Обработчики нужно привязать к событиям элементов формы (палитра свойств -> События):
//   УслугиУслуга     -> ПриИзменении -> УслугиУслугаПриИзменении
//   УслугиКоличество -> ПриИзменении -> УслугиКоличествоПриИзменении
//   УслугиЦена       -> ПриИзменении -> УслугиКоличествоПриИзменении
//   Услуги (таблица) -> ПослеУдаления -> УслугиПослеУдаления

&НаСервереБезКонтекста
Функция ЦенаУслуги(Услуга, НаДату)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЦеныУслугСрезПоследних.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныУслуг.СрезПоследних(&НаДату, Услуга = &Услуга) КАК ЦеныУслугСрезПоследних";
	Запрос.УстановитьПараметр("Услуга", Услуга);
	Запрос.УстановитьПараметр("НаДату", НаДату);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Цена;
	КонецЕсли;

	// Если в регистре цены нет — берём цену из справочника.
	Возврат Услуга.Цена;

КонецФункции

&НаКлиенте
Процедура УслугиУслугаПриИзменении(Элемент)

	Строка = Элементы.Услуги.ТекущиеДанные;
	Если Строка.Количество = 0 Тогда
		Строка.Количество = 1;
	КонецЕсли;
	Строка.Цена = ЦенаУслуги(Строка.Услуга, ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата()));
	ПересчитатьСтроку(Строка);

КонецПроцедуры

&НаКлиенте
Процедура УслугиКоличествоПриИзменении(Элемент)

	ПересчитатьСтроку(Элементы.Услуги.ТекущиеДанные);

КонецПроцедуры

&НаКлиенте
Процедура УслугиПослеУдаления(Элемент)

	Объект.Сумма = Объект.Услуги.Итог("Сумма");

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтроку(Строка)

	Строка.Сумма = Строка.Количество * Строка.Цена;
	Объект.Сумма = Объект.Услуги.Итог("Сумма");

КонецПроцедуры
